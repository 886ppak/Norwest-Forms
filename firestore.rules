rules_version = '2';

// Norwest Forms usage-logging rules. This app has no login (deliberately
// - see README), so there's no Firebase Auth identity to gate on; the
// client writes are genuinely anonymous/unauthenticated. Write-only and
// tightly shaped instead: a client can create a well-formed event
// document and nothing else - never read, update, delete, or list this
// collection. Reading is only for the owner's private admin dashboard
// (isAdmin() below: a verified sign-in - Google, or a passkey through the
// homelab's Authentik (functions adminPasskeySignIn) - as a listed email) and
// the service account (functions, tools/usage-stats.mjs), which bypasses
// these rules. Usage logging is ongoing until the owner switches it off;
// expireAt plus the Firestore TTL policy on that field deletes each
// record after ~60 days (the weekly Nextcloud export keeps the history).
service cloud.firestore {
  match /databases/{database}/documents {
    // The owner's two accounts, which may READ the usage log and help
    // reports from the private dashboard (admin.html - Google sign-in, or a
    // passkey through Authentik; keep in step with ADMIN_EMAILS in
    // functions/index.js). Workers never sign in;
    // their no-login creates below are unchanged. To add/remove an admin,
    // edit this list and run: firebase deploy --only firestore:rules
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.email in ['myslewer@gmail.com', '15buzza@gmail.com'];
    }

    match /submissions/{eventId} {
      allow create: if request.resource.data.keys().hasOnly(['formType', 'name', 'company', 'ip', 'inst', 'submittedAt', 'expireAt'])
                     && request.resource.data.formType is string
                     && request.resource.data.formType in ['timesheet', 'leave', 'training', 'medical']
                     && request.resource.data.name is string
                     && request.resource.data.name.size() <= 80
                     && request.resource.data.company is string
                     && request.resource.data.company.size() <= 10
                     && request.resource.data.ip is string
                     && request.resource.data.ip.size() <= 45
                     // v1.47: installed PWA (true) vs browser (false) at send
                     // time - optional so pre-v1.47 clients still pass.
                     && (!('inst' in request.resource.data) || request.resource.data.inst is bool)
                     && request.resource.data.submittedAt is timestamp
                     // Kept 90 days in Firestore, then TTL deletes it. Every
                     // month is archived to Nextcloud before that (functions
                     // archiveUsageDaily), so nothing is lost.
                     && request.resource.data.expireAt is timestamp
                     && request.resource.data.expireAt > request.resource.data.submittedAt;
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    // Help tab issue reports (index.html sendHelpReport -> functions/
    // index.js deliverHelpReport). Same no-login, create-only, tightly
    // shaped approach as submissions above: a client can file a report
    // and nothing else. The function (admin, bypasses these rules)
    // forwards it to Nextcloud + Discord and then deletes the screenshots.
    match /helpReports/{reportId} {
      allow create: if reportId.matches('[A-Z0-9]{6,12}')
                     && request.resource.data.keys().hasOnly(['ref', 'category', 'message', 'name', 'contact', 'company', 'formTab', 'appVersion', 'jobNumbers', 'device', 'shotCount', 'createdAt'])
                     && request.resource.data.keys().hasAll(['ref', 'category', 'message', 'shotCount', 'createdAt'])
                     && request.resource.data.ref == reportId
                     && request.resource.data.category in ['jobnumbers', 'pdf', 'looks', 'idea', 'other']
                     && request.resource.data.message is string
                     && request.resource.data.message.size() > 0
                     && request.resource.data.message.size() <= 2000
                     && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 80))
                     && (!('contact' in request.resource.data) || (request.resource.data.contact is string && request.resource.data.contact.size() <= 120))
                     && (!('company' in request.resource.data) || (request.resource.data.company is string && request.resource.data.company.size() <= 10))
                     && (!('formTab' in request.resource.data) || (request.resource.data.formTab is string && request.resource.data.formTab.size() <= 20))
                     && (!('appVersion' in request.resource.data) || (request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 12))
                     && (!('jobNumbers' in request.resource.data) || (request.resource.data.jobNumbers is string && request.resource.data.jobNumbers.size() <= 200))
                     && (!('device' in request.resource.data) || (request.resource.data.device is string && request.resource.data.device.size() <= 400))
                     && request.resource.data.shotCount is int
                     && request.resource.data.shotCount >= 0
                     && request.resource.data.shotCount <= 3
                     && request.resource.data.createdAt is timestamp
                     && request.resource.data.createdAt > request.time - duration.value(15, 'm')
                     && request.resource.data.createdAt < request.time + duration.value(15, 'm');
      allow get, list: if isAdmin();
      allow update, delete: if false;

      // Screenshots: base64 JPEG, written just before the report itself.
      match /shots/{shotId} {
        allow create: if shotId in ['0', '1', '2']
                       && request.resource.data.keys().hasOnly(['data', 'type'])
                       && request.resource.data.type == 'image/jpeg'
                       && request.resource.data.data is string
                       && request.resource.data.data.size() > 100
                       && request.resource.data.data.size() <= 700000;
        allow get, list, update, delete: if false;
      }
    }

    // Usage events: how often the app is opened, and how often the
    // mobilisation-email import actually puts a job on someone's calendar
    // (index.html logAppOpen / logCalImport). Same no-login, create-only,
    // tightly shaped approach as `submissions`, and deliberately NOT
    // identifying: no name, no company beyond NCH/NWP, no IP. The device id
    // is a random value the phone makes for itself, never tied to a person.
    // Kept 90 days in Firestore, archived to Nextcloud well before that.
    match /usageEvents/{eventId} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'at', 'expireAt', 'device', 'appVersion', 'inst', 'via', 'jobs', 'company'])
                     && request.resource.data.kind is string
                     && request.resource.data.kind in ['open', 'calimport']
                     && request.resource.data.at is timestamp
                     && request.resource.data.expireAt is timestamp
                     && request.resource.data.expireAt > request.resource.data.at
                     && request.resource.data.device is string
                     && request.resource.data.device.size() <= 32
                     && request.resource.data.appVersion is string
                     && request.resource.data.appVersion.size() <= 12
                     && request.resource.data.inst is bool
                     // calendar-import records may carry how it arrived and how many jobs
                     && (!('via' in request.resource.data) || request.resource.data.via in ['share', 'paste'])
                     && (!('jobs' in request.resource.data) || (request.resource.data.jobs is int && request.resource.data.jobs >= 0 && request.resource.data.jobs <= 50))
                     && (!('company' in request.resource.data) || (request.resource.data.company is string && request.resource.data.company.size() <= 10));
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    // Deny everything else outright - an explicit fallback rather than
    // relying on Firestore's own "no matching rule = denied" default, so
    // adding some unrelated collection later can't accidentally inherit
    // more access than intended just by sitting under the same database.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
