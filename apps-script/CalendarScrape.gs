// GENERATED by tools/build-calscrape.js. Edit index.html parser or apps-script/calscrape/main.gs, then rebuild.
const CAL_SHIFT_RE = /^(DS|NS)\d?$/i;
const CAL_COMMUTE_RE = /^(DIDO|FIFO)$/i;
const CAL_TRAVEL_RE = /DRIVE|FLY|ALREADY|STAY|TRANSFER|SITE|DIDO|FIFO/i;
const CAL_SDFD_RE = /\b(SD|FD)\b|STAND DOWN|FATIGUE|REQUIRED/i;
const CAL_ID_RE = /^([A-Z]{1,3}\d{4,}|[\d\/\- ]+)$/i;   // card / phone numbers: never kept
const CAL_STOP_RE = /^(please|kind regards|regards|good (morning|afternoon|evening)|hi\b|hello|thanks|cheers|this message)/i;
let calView = null;      // {y, m} with m = 1..12
let calPending = null;   // jobs read from an email, waiting for review

// ===== begin parser =====
// DS1, DS2, DS3... are all day shift; NS1, NS2... are all night shift
function calCodeLabel(c){ return c === 'FIFO' ? 'FI/FO' : c; }
function calShiftBase(v){ v=String(v||'').toUpperCase(); return /^NS/.test(v) ? 'NS' : /^DS/.test(v) ? 'DS' : v; }
function calEsc(s){ return String(s==null?'':s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function calNorm(s){ return String(s||'').toLowerCase().replace(/[^a-z ]/g,' ').replace(/\s+/g,' ').trim(); }
// "2/09/2026" or "30/07/26" (day first, as in Australia) -> "2026-09-02"; anything else -> ''
function calIsoOf(text){
  const m = /^(\d{1,2})\/(\d{1,2})\/(\d{4}|\d{2})$/.exec(String(text||'').trim());
  if(!m) return '';
  const d=+m[1], mo=+m[2], y = m[3].length===2 ? 2000+(+m[3]) : +m[3];
  const dt = new Date(Date.UTC(y, mo-1, d));
  if(dt.getUTCDate()!==d || dt.getUTCMonth()!==mo-1) return '';
  return dt.toISOString().slice(0,10);
}
// Every cell in reading order. Table rows are split on tabs or 2+ spaces; a
// pasted "one cell per line" table is read the same way, so blank cells are
// simply absent and the parser matches values by type, not by position.
function calCells(text){
  const out=[];
  String(text||'').split(/\r?\n/).forEach(line=>{
    line.split(/\t|\s{2,}/).map(c=>c.trim()).filter(Boolean).forEach(c=>out.push(c));
  });
  return out;
}
// Build one job from the cells around the worker's name (index n).
function calParseRow(cells, n){
  const warnings=[];
  // VD job number: the 5-digit cell just before the name (only in some layouts)
  let vdIdx=-1;
  for(let i=n-1;i>=Math.max(0,n-4);i--){ if(/^\d{5}$/.test(cells[i])){ vdIdx=i; break; } }
  const vd = vdIdx>=0 ? cells[vdIdx] : '';
  const site = (vdIdx>=0 && vdIdx<=n-3) ? cells[vdIdx+1] : '';
  const cls = (n-1>vdIdx && n-1>=0 && n-1!==vdIdx+1 && !calIsoOf(cells[n-1]) && !/^\d{5}$/.test(cells[n-1])) ? cells[n-1] : '';
  // Everything after the name until the next person or the end of the row
  const rest=[];
  let dateCount=0, lastDate=-1;
  for(let i=n+1;i<cells.length;i++){
    const c=cells[i];
    if(CAL_STOP_RE.test(c) || /^\d{5}$/.test(c)) break;
    rest.push(c);
    if(calIsoOf(c)){ dateCount++; lastDate=rest.length-1; }
    if(dateCount>=4 && rest.length-1-lastDate>=2) break;   // demob + travel out + accommodation, then stop
  }
  let shift='', commute='';
  const isoDates=[], texts=[];
  for(const c of rest){
    if(!shift && CAL_SHIFT_RE.test(c)){ shift = calShiftBase(c); continue; }
    if(CAL_COMMUTE_RE.test(c)){ commute=c.toUpperCase(); continue; }
    const iso=calIsoOf(c);
    if(iso){ isoDates.push(iso); continue; }
    if(CAL_ID_RE.test(c)) continue;
    texts.push(c);
  }
  // Dates in column order: MOB, first shift, last shift, [SD/FD date], DMOB
  const mob=isoDates[0]||'', first=isoDates[1]||'', last=isoDates[2]||'';
  const demob = isoDates.length>=5 ? isoDates[4] : (isoDates[3]||'');
  const sdDate = isoDates.length>=5 ? isoDates[3] : '';
  const sdTexts = texts.filter(t=>CAL_SDFD_RE.test(t));
  const others = texts.filter(t=>!CAL_SDFD_RE.test(t));
  const travel = others.filter(t=>CAL_TRAVEL_RE.test(t));
  const accom = others.filter(t=>!CAL_TRAVEL_RE.test(t));
  const sdTextDate = sdTexts.map(t=>{ const m=/(\d{1,2}\/\d{1,2}\/(?:\d{4}|\d{2}))/.exec(t); return m?calIsoOf(m[1]):''; }).find(Boolean) || '';
  if(!shift) warnings.push('Shift (DS / NS) not found');
  if(isoDates.length<4) warnings.push('Only '+isoDates.length+' dates found: check MOB, first shift, last shift and DMOB');
  if(first && last && first>last) warnings.push('First shift is after last shift');
  if(mob && first && mob>first) warnings.push('MOB is after first shift');
  if(last && demob && last>demob) warnings.push('Last shift is after DMOB');
  return {
    vd, site, cls, commute, shift, mob, first, last, demob,
    sdDate: sdDate || sdTextDate, sdText: sdTexts.join(' '),
    travelIn: travel[0]||'', travelOut: travel[1]||'', accom: accom.join(' '),
    hasTravel: travel.length>0 || !!commute, warnings
  };
}
// All job rows for this worker in the text. Returns {jobs} or {error}.
function calParseEmail(text, name, subject){
  const want = calNorm(name);
  if(!want) return {error:'Type your name first (under My name). It has to match the name on the email.'};
  const cells = calCells(text);
  const jobs=[];
  cells.forEach((c,n)=>{
    if(calNorm(c)!==want) return;
    const j = calParseRow(cells,n);
    if(!j.hasTravel || !j.shift) return;   // a contact list or prose mention, not a job row
    j.site = j.site || subject || '';
    jobs.push(j);
  });
  if(!jobs.length) return {error:'Your name wasn’t found as a job row in this text. Check the spelling under My name matches the email, then try again.'};
  return {jobs};
}
// ===== end parser =====

// ===== NCH job calendar scraper (owner account only) =====
// Reads mobilisation emails from the owner's Gmail, parses the worker's own row
// with the same parser as the PWA share feature, and writes the jobs to a
// Google Calendar. Runs on an hourly time trigger. Nothing leaves the account.
//
// Script properties (Project Settings > Script properties):
//   WORKER_NAME   required, exactly as it appears on the email, e.g. "Aiden Amur"
//   SEARCH_QUERY  optional Gmail search (default below)
//   CALENDAR_NAME optional, default "NCH jobs"
//   ALERT_TO      optional, email address for the summary of each run that did something

function csConfig_() {
  const p = PropertiesService.getScriptProperties();
  return {
    name: String(p.getProperty('WORKER_NAME') || '').trim(),
    query: p.getProperty('SEARCH_QUERY') ||
      'newer_than:120d (subject:mobilisation OR subject:"travel confirmation" OR subject:mobe)',
    calendarName: p.getProperty('CALENDAR_NAME') || 'NCH jobs',
    alertTo: String(p.getProperty('ALERT_TO') || '').trim(),
    doneLabel: 'nch-jobs-imported'
  };
}

// Same key the PWA uses for a job (calJobKey), so a job keeps one identity.
function csJobKey_(job) { return [job.vd, job.mob, job.first, job.last, job.shift, job.cls].join('|'); }

function csDesc_(job) {
  const lines = [];
  if (job.cls) lines.push('Class: ' + job.cls);
  if (job.commute) lines.push('Commute: ' + job.commute);
  if (job.travelIn) lines.push('Travel in: ' + job.travelIn);
  if (job.travelOut) lines.push('Travel out: ' + job.travelOut);
  if (job.accom) lines.push('Accommodation: ' + job.accom);
  if (job.sdText) lines.push('SD/FD: ' + job.sdText);
  if (job.warnings && job.warnings.length) lines.push('Check: ' + job.warnings.join('; '));
  return lines.join('\n');
}

// Pure function (no Google services): one parsed job -> calendar items.
// Dates are 'YYYY-MM-DD'; end is inclusive.
function csJobItems(job) {
  const base = csJobKey_(job);
  const where = [job.vd, job.site].filter(Boolean).join(' ');
  const items = [];
  if (job.first && job.last) {
    items.push({ key: base + '|shift', title: job.shift + ' ' + where, start: job.first, end: job.last, description: csDesc_(job) });
  }
  if (job.mob) items.push({ key: base + '|mob', title: 'MOB ' + where, start: job.mob, end: job.mob, description: '' });
  if (job.demob) items.push({ key: base + '|demob', title: 'DMOB ' + where, start: job.demob, end: job.demob, description: '' });
  if (job.sdDate) items.push({ key: base + '|sd', title: 'SD/FD ' + where, start: job.sdDate, end: job.sdDate, description: job.sdText || '' });
  return items;
}

function csDate_(iso, plusDays) {
  const p = iso.split('-').map(Number);
  return new Date(p[0], p[1] - 1, p[2] + (plusDays || 0));
}

function csEnsureCalendar_(name) {
  const found = CalendarApp.getCalendarsByName(name);
  if (found.length) return found[0];
  return CalendarApp.createCalendar(name, { timeZone: 'Australia/Perth' });
}

// Create missing events, update changed ones. Events are found by a tag holding the item key.
function csSync_(cal, items) {
  const result = { created: 0, updated: 0 };
  if (!items.length) return result;
  const starts = items.map(i => i.start).sort();
  const ends = items.map(i => i.end).sort();
  const from = csDate_(starts[0], -1);
  const to = csDate_(ends[ends.length - 1], 2);
  const existing = {};
  cal.getEvents(from, to).forEach(ev => {
    const k = ev.getTag('nchkey');
    if (k) existing[k] = ev;
  });
  items.forEach(it => {
    const ev = existing[it.key];
    if (ev) {
      if (ev.getTitle() !== it.title || ev.getDescription() !== it.description) {
        ev.setTitle(it.title);
        ev.setDescription(it.description);
        result.updated++;
      }
      return;
    }
    const created = cal.createAllDayEvent(it.title, csDate_(it.start), csDate_(it.end, 1), { description: it.description });
    created.setTag('nchkey', it.key);
    result.created++;
  });
  return result;
}

// Main entry point for the hourly trigger.
function scrapeJobEmails() {
  const cfg = csConfig_();
  if (!cfg.name) throw new Error('Set WORKER_NAME in Project Settings > Script properties first.');
  const label = GmailApp.getUserLabelByName(cfg.doneLabel) || GmailApp.createLabel(cfg.doneLabel);
  const threads = GmailApp.search(cfg.query + ' -label:' + cfg.doneLabel, 0, 100);
  const report = { threads: threads.length, jobs: [], skipped: [], warnings: [], created: 0, updated: 0 };
  const items = [];

  threads.forEach(thread => {
    thread.getMessages().forEach(msg => {
      const subject = msg.getSubject();
      const r = calParseEmail(msg.getPlainBody(), cfg.name, subject);
      if (r.error || !r.jobs) {
        report.skipped.push(subject + ' (' + String(r.error || 'no job rows').slice(0, 80) + ')');
        return;
      }
      r.jobs.forEach(job => {
        report.jobs.push((job.vd || '') + ' ' + (job.site || subject) + ' ' + job.first + ' to ' + job.last);
        job.warnings.forEach(w => report.warnings.push(subject + ': ' + w));
        csJobItems(job).forEach(it => items.push(it));
      });
    });
    thread.addLabel(label);
  });

  const cal = csEnsureCalendar_(cfg.calendarName);
  const sync = csSync_(cal, items);
  report.created = sync.created;
  report.updated = sync.updated;

  if (cfg.alertTo && (report.threads > 0)) {
    const body = [
      'Threads checked: ' + report.threads,
      'Jobs found: ' + report.jobs.length + ' (created ' + report.created + ', updated ' + report.updated + ')',
      '',
      report.jobs.length ? 'Jobs:\n  ' + report.jobs.join('\n  ') : '',
      report.warnings.length ? 'Check these:\n  ' + report.warnings.join('\n  ') : '',
      report.skipped.length ? 'Skipped:\n  ' + report.skipped.join('\n  ') : ''
    ].filter(Boolean).join('\n');
    MailApp.sendEmail(cfg.alertTo, 'NCH jobs: ' + report.created + ' new, ' + report.updated + ' updated', body);
  }
  Logger.log(JSON.stringify(report));
  return report;
}

// Run once by hand after setting WORKER_NAME. Installs the hourly trigger.
function installHourlyTrigger() {
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === 'scrapeJobEmails') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('scrapeJobEmails').timeBased().everyHours(1).create();
}
